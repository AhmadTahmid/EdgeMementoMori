{
  "manifest_version": 3,
  "name": "Memento Mori New Tab",
  "version": "1.1",
  "description": "A Memento Mori countdown timer on every new tab.",
  "permissions": [
    "tabs"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "background.png"
  },
  "icons": {
    "128": "background.png"
  }
}